---
// apps/docs/src/components/Demo.astro
// Renders a single example card (preview + code).
import Example from './Example.astro';
import ReactRouter from './ReactRouter.tsx';
import SvelteRouter from './SvelteRouter.svelte';
import SsrRouter from './SsrRouter.astro';
import PreviewFrame from './PreviewFrame.astro';

interface Props {
  component?: string;
  example?: string;
}

const { component = 'button', example = 'default' } = Astro.props;

// Read the raw source code for the toggles (this works fine in Astro).
// For the actual execution, we defer to the ReactRouter/SvelteRouter.
const reactRawModules = import.meta.glob('./examples/*/*/react.tsx', { query: '?raw', import: 'default' });
const svelteRawModules = import.meta.glob('./examples/*/*/svelte.svelte', { query: '?raw', import: 'default' });

const reactPath = `./examples/${component}/${example}/react.tsx`;
const sveltePath = `./examples/${component}/${example}/svelte.svelte`;

const reactCode = (await reactRawModules[reactPath]?.()) as string | undefined;
const svelteCode = (await svelteRawModules[sveltePath]?.()) as string | undefined;

const title = example
  .split('-')
  .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
  .join(' ');

const isPreviewFrame = ['sidebar', 'page'].includes(component);

const SSR_EXAMPLES = new Set([
  'mermaid/prerendered',
  'latex/prerendered',
  'code-block/prerendered',
  'chart/prerendered',
  'editor/server-reader'
]);
const isSsr = SSR_EXAMPLES.has(`${component}/${example}`);

const isClientOnly = component === 'navbar';
const isScrollableEditor = component === 'editor';

// Full-bleed demos render flush to the card edges (no ExampleScreen padding).
const FULLSCREEN_EXAMPLES = new Set([
  'sidebar/icon',
  'sidebar/offcanvas',
  'sidebar/rail',
  'page/default',
  'page/footer',
  'page/gutter-scroll',
  'page/gutters',
  'page/landing',
  'navbar/sticky',
  'navbar/floating',
  'navbar/shrink',
  'navbar/scroll',
  'navbar/hide',
  'dialog/fullscreen',
]);
const isFullscreen = FULLSCREEN_EXAMPLES.has(`${component}/${example}`);
---

<div class="w-full" data-demo-region>
  <Example 
    id={example} 
    title={title} 
    reactCode={reactCode || ''} 
    svelteCode={svelteCode || ''}
    fullscreen={isFullscreen}
  >
    <div class:list={[isScrollableEditor && 'max-h-96 overflow-y-auto overscroll-contain']} data-editor-demo-scroll={isScrollableEditor || undefined}>
    {isSsr ? (
      <SsrRouter component={component} example={example} />
    ) : isPreviewFrame ? (
      <PreviewFrame component={component} example={example} desktopWidth={component === 'sidebar' ? 1024 : undefined} />
    ) : isClientOnly ? (
      <>
        <div data-fw="react">
          <ReactRouter component={component} example={example} client:only="react" />
        </div>
        <div data-fw="svelte">
          <SvelteRouter component={component} example={example} client:only="svelte" />
        </div>
      </>
    ) : (
      <>
        <div data-fw="react">
          <ReactRouter component={component} example={example} client:load />
        </div>
        <div data-fw="svelte">
          <SvelteRouter component={component} example={example} client:load />
        </div>
      </>
    )}
    </div>
  </Example>
</div>
